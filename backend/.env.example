# Optional persistent Supabase PostgreSQL database. Keep the real connection string in Render env vars only.
# LIFTELY_DATABASE_URL=postgresql://...

# Render/production e-mail action links point back to this HTTPS API origin.
LIFTELY_PUBLIC_BASE_URL=

# Brevo transactional email API (recommended on Render Free; uses HTTPS).
# Create a key in Brevo and set it only in Render's environment, never commit a real key.
LIFTELY_BREVO_API_KEY=
LIFTELY_EMAIL_SENDER_NAME=LIFTELY

# SMTP (TLS required): use port 587 with STARTTLS, or set SSL=true for port 465.
LIFTELY_SMTP_HOST=
LIFTELY_SMTP_PORT=587
LIFTELY_SMTP_USERNAME=
LIFTELY_SMTP_PASSWORD=
LIFTELY_SMTP_USE_SSL=false
LIFTELY_EMAIL_FROM=
LIFTELY_EMAIL_PROVIDER=

# Public privacy notice details: fill these with verified information before launch.
LIFTELY_DATA_CONTROLLER=
LIFTELY_DATA_CONTROLLER_ADDRESS=
LIFTELY_PRIVACY_CONTACT=
LIFTELY_HOSTING_PROVIDER=Render
LIFTELY_HOSTING_REGION=
LIFTELY_BACKUP_RETENTION=
LIFTELY_LOG_RETENTION=
