# Backend API base URL
# Leave unset only when the Expo host fallback is appropriate for your network.
# For local backend testing, replace this with the PC's current LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:5001
# For the hosted backend, use the HTTPS URL (requests affect hosted data):
EXPO_PUBLIC_API_URL=https://liftely-api.onrender.com
